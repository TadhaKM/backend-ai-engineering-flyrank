# Assignment 05 — configuration.
#
# Both values have working defaults, so the server runs with no .env at all.
# Copy this to `.env` only if you want to change one.

# Port the API listens on.
PORT=3000

# Path to the SQLite database file. Relative to where you start the server.
# Created automatically on first run; delete it to start from a clean seed.
DB_FILE=tasks.db

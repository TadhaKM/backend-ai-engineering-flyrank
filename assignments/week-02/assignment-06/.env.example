# Assignment 06 — configuration.
#
#   cp .env.example .env      then fill in your Supabase project's values.
#
# `.env` is git-ignored; this file is committed so others know WHICH variables
# exist without ever learning their VALUES. NEVER commit real Supabase keys.

# From your Supabase dashboard: Project Settings -> API.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# The "anon" public key (Project Settings -> API -> Project API keys -> anon).
# It is safe to use from a client; it is NOT the service_role key. Keep the
# service_role key out of this project entirely.
SUPABASE_KEY=your_anon_key

# The port the server listens on.
PORT=3000
